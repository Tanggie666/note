# ===== 运行时数据：绝不进仓库 =====
# 数据库（含管理员密码哈希、便签密文）
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
# 但保留访问守卫文件
!data/.htaccess

# 照片原件 / 密文
photos/*
!photos/.htaccess

